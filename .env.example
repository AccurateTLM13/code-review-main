# Copy to `.env` in the repository root and fill in what you need.
# `.env` is git-ignored — never commit real keys.
#
# OpenRouter (cloud models; free-tier models exist — see https://openrouter.ai/models)
# Add a line that assigns your OpenRouter key to the OPENROUTER_API_KEY
# environment variable. The key itself starts with "sk-or-" — keep it in
# `.env`, never in tracked files.
#
# Optional: override the default local Ollama endpoint (e.g. a remote host)
# OLLAMA_HOST=http://localhost:11434
#
# Optional: explicit config file path (otherwise defaults/user/repo config merge applies)
# CODE_AUDIT_CONFIG=
